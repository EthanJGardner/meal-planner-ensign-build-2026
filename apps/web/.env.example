# Copy to .env.local (git-ignored) and fill in. Only VITE_* variables reach the
# browser, so never put a server secret here.

# Where the FastAPI server is. Leave empty to use the same origin: in
# development the Vite proxy sends /api to http://localhost:8000.
VITE_API_URL=

# The Supabase gateway, used for sign-in only.
VITE_SUPABASE_URL=http://localhost:54321

# The public anon key: SUPABASE_ANON_KEY in the repo root .env, written by
# scripts/gen-env.py. Without it the app runs for guests only and the sign-in
# pages say sign-in is not configured.
VITE_SUPABASE_ANON_KEY=
