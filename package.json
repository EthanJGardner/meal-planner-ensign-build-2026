{
  "name": "meal-planner",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run \"/^dev:.*/\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "uv run --package api fastapi dev apps/api/src/api/main.py",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint"
  }
}
